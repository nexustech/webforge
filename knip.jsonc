{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Loaded by dependency-cruiser at runtime (parser: "swc"); never imported directly.
      "ignoreDependencies": ["@swc/core"]
    },
    "apps/*": {},
    "apps/desktop": {
      // Imported by @webforge/storage, which is bundled from source. Listed as a dependency so
      // electron-vite keeps it external and electron-builder packages it (ADR 0003).
      "ignoreDependencies": ["better-sqlite3"]
    },
    "packages/*": {}
  }
}

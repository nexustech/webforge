{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Golden output and the UI-string guard's fixtures are read as data, never imported.
  "ignore": ["**/test/golden/**", "tools/test/fixtures/**"],
  "workspaces": {
    ".": {
      // Loaded by dependency-cruiser at runtime (parser: "swc"); never imported directly.
      "ignoreDependencies": ["@swc/core"]
    },
    "apps/*": {},
    "apps/desktop": {
      // The export worker is a second main-process input in electron.vite.config.ts.
      "entry": ["src/worker/export-worker.ts"],
      // Imported by @webforge/storage, which is bundled from source. Listed as a dependency so
      // electron-vite keeps it external and electron-builder packages it (ADR 0003).
      "ignoreDependencies": ["better-sqlite3"]
    },
    "e2e": {
      // The export-setup project (playwright.config.ts) runs before the exported-site tests.
      // The perf tests (perf/*.perf.ts, pnpm e2e:perf) use a custom testMatch.
      // playwright.visual.config.ts starts visual/serve-storybook.ts as its web server.
      "entry": ["export/*.setup.ts", "perf/*.perf.ts", "visual/serve-storybook.ts"]
    },
    "packages/*": {},
    "packages/storage": {
      // Run by hand to write a format's .wforge fixture (see the script's header).
      "entry": ["test/support/make-v1-fixture.ts"]
    },
    "packages/pipeline": {
      // Font files are read by path (require.resolve) in src/node-resources.ts.
      "ignoreDependencies": ["@fontsource/inter"]
    }
  }
}

// R10 (#671, #989): a branded id (`PageId`, `MediaId`, …) is made by its zod schema, `newId` or
// `pageId`, and an id from elsewhere is checked against the site with the model's helpers
// (`isPageIn`, `pageEntryOf`, `pageIdsOf`, `isSharedSectionIn`, `sharedSectionOf`,
// `isCollectionIn`, `mediaItem`; `keysOf`, `entriesOf` and `isKeyOf` for any record): never cast,
// not even in a union or a tuple (`as PageId | undefined`). biome.json leaves out `ids.ts`, which
// defines the brands, and test code.
language js

`$value as $type` where {
  $type <: r"(?s).*\b(?:PageId|MediaId|MenuItemId|SharedSectionId|CollectionId|ThemeId)\b.*|^keyof\s+SiteDoc\b.*",
  register_diagnostic(span=$value, message="Don't cast to a branded id: parse it with its schema or pageId, or look it up with the model's helpers (isPageIn, pageEntryOf, pageIdsOf, isSharedSectionIn, sharedSectionOf, isCollectionIn, mediaItem, keysOf, entriesOf, isKeyOf).")
}

                },
                "pageId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "kind",
                "pageId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "layout"
                },
                "part": {
                  "type": "string",
                  "enum": [
                    "header",

{
  "name": "@webforge/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Webforge desktop app",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm run ensure-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "pnpm run ensure-electron && electron-vite preview",
    "ensure-electron": "node ../../tools/src/ensure-electron.ts",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "package:e2e": "electron-vite build --mode e2e && electron-builder --dir --publish never",
    "build:perf": "electron-vite build --mode perf"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "catalog:",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.12",
    "ssh2": "1.17.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@jsquash/jpeg": "catalog:",
    "@jsquash/png": "catalog:",
    "@jsquash/resize": "catalog:",
    "@jsquash/webp": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.2.1",
    "@webforge/commands": "workspace:*",
    "@webforge/editor-ui": "workspace:*",
    "@webforge/engine": "workspace:*",
    "@webforge/errors": "workspace:*",
    "@webforge/help": "workspace:*",
    "@webforge/history": "workspace:*",
    "@webforge/i18n": "workspace:*",
    "@webforge/mcp-bridge": "workspace:*",
    "@webforge/model": "workspace:*",
    "@webforge/pipeline": "workspace:*",
    "@webforge/publish": "workspace:*",
    "@webforge/site-check": "workspace:*",
    "@webforge/site-components": "workspace:*",
    "@webforge/storage": "workspace:*",
    "@webforge/templates": "workspace:*",
    "@webforge/test-utils": "workspace:*",
    "@webforge/themes": "workspace:*",
    "@webforge/tools": "workspace:*",
    "ajv": "8.20.0",
    "babel-plugin-react-compiler": "catalog:",
    "daisyui": "catalog:",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "lucide-react": "1.70.0",
    "lucide-static": "1.70.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.6",
    "tailwindcss": "catalog:",
    "vite": "8.3.6",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "5.1.0"
  }
}

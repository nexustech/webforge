{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No "dom": the pipeline runs in Node (a utilityProcess), so a `document` or `window` in it is
    // a type error. The one browser type jSquash's codecs use, ImageData, is in image-data.d.ts.
    "lib": ["es2024"],
    "types": ["node"]
  },
  "include": ["src", "test"],
  "references": [
    { "path": "../i18n" },
    { "path": "../model" },
    { "path": "../site-components" },
    { "path": "../test-utils" }
  ]
}

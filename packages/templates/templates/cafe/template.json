      "cafe-menu": {
        "id": "cafe-menu",
        "kind": "page",
        "slug": "menu",
        "title": "Menu",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "TextSection",
              "props": {
                "id": "breakfast",
                "colors": "page",
                "title": "Breakfast, until 11:30",
                "text": "<p><strong>Full breakfast</strong> · £10.50<br>Two eggs, bacon or mushrooms, sausage, beans, tomato and sourdough toast.</p><p><strong>Eggs on toast</strong> · £6.50<br>Poached, fried or scrambled, on sourdough or seeded toast.</p><p><strong>Porridge</strong> · £5.00<br>With berries and honey, or brown sugar and cream.</p><p><strong>Bacon roll</strong> · £4.50<br>Smoked bacon in a soft white roll. Add an egg for £1.</p>"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "id": "lunch",
                "colors": "inverse",
                "title": "Lunch, from 11:30",
                "text": "<p><strong>Soup of the day</strong> · £6.50<br>Made fresh each morning, with bread and butter.</p><p><strong>Toasted sandwiches</strong> · £7.50<br>Cheese and onion, ham and mustard, or mushroom and spinach.</p><p><strong>Jacket potato</strong> · £7.00<br>With cheese and beans, tuna mayonnaise or chilli.</p><p><strong>Ploughman's</strong> · £9.50<br>Local cheese, ham, pickle, apple and a crusty roll.</p>"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "id": "cakes",
                "colors": "page",
                "title": "Cakes and bakes",
                "text": "<p><strong>Scone with jam and cream</strong> · £4.00<br>Plain or fruit, still warm in the morning.</p><p><strong>Lemon drizzle</strong> · £3.50<br>Our most asked-for cake.</p><p><strong>Chocolate brownie</strong> · £3.50<br>Gluten-free, and nobody can tell.</p><p><strong>Cake of the day</strong> · £3.75<br>Ask at the counter, or look at the board.</p>"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "id": "drinks",
                "colors": "page",
                "title": "Drinks",
                "text": "<p><strong>Coffee</strong> · from £2.80<br>Espresso, americano, flat white, latte and cappuccino. Oat milk at no extra cost.</p><p><strong>Tea</strong> · £2.50<br>A pot of breakfast tea, Earl Grey, green or peppermint.</p><p><strong>Hot chocolate</strong> · £3.50<br>With cream and marshmallows if you like.</p><p><strong>Cold drinks</strong> · from £2.20<br>Fresh orange juice, local apple juice and sparkling water.</p>"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "id": "allergies",
                "colors": "page",
                "title": "Allergies",
                "text": "<p>Please tell us about any allergies when you order. Our kitchen handles nuts, gluten, dairy and eggs, so we can't promise that a dish is free of them.</p>"
              }
            }
          ]
        }
      },
      "cafe-about": {
        "id": "cafe-about",
        "kind": "page",
        "slug": "about",
        "title": "About us",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "TextImage",
              "props": {
                "id": "story",
                "variant": "imageLeft",
                "colors": "page",
                "title": "Our story",
                "text": "<p>Hannah opened The Copper Kettle in 2016, in what used to be the town's ironmonger. The old copper kettle on the counter came with the building.</p><p>We cook everything here, we buy from farms and bakers nearby, and we try to make every visit feel like coming round to a friend's for breakfast.</p>",
                "image": {
                  "mediaId": "cafe-riverside"
                }
              }
            },
            {
              "type": "Team",
              "props": {
                "id": "team",
                "variant": "cards",
                "colors": "page",
                "title": "Who you'll meet",
                "text": "<p>A small team, most mornings.</p>",
                "items": [
                  {
                    "type": "TeamMember",
                    "props": {
                      "id": "member-0",
                      "name": "Hannah",
                      "role": "Owner",
                      "text": "<p>Makes the coffee, knows everyone's order, and bakes the scones.</p>",
                      "photo": {
                        "mediaId": "cafe-hannah"
                      }
                    }
                  },
                  {
                    "type": "TeamMember",
                    "props": {
                      "id": "member-1",
                      "name": "Sam",
                      "role": "Cook",
                      "text": "<p>Runs the kitchen, and has opinions about how to fry an egg.</p>",
                      "photo": {
                        "mediaId": "cafe-sam"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "cafe-visit": {
        "id": "cafe-visit",
        "kind": "page",
        "slug": "visit",
        "title": "Visit us",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "ContactDetails",
              "props": {
                "id": "contact-details",
                "variant": "split",
                "colors": "page",
                "title": "Find us",
                "text": "<p>On Bridge Street, by the river. There's a car park two minutes' walk away.</p>",
                "showHours": true,
                "showContact": true
              }
            },
            {
              "type": "Faq",
              "props": {
                "id": "faq",
                "variant": "accordion",
                "colors": "page",
                "title": "Good to know",
                "items": [
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-0",
                      "question": "Do you take bookings?",
                      "answer": "<p>For six or more, yes: call us the day before. Otherwise just come in, and we'll find you a seat.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-1",
                      "question": "Can I bring my dog?",
                      "answer": "<p>Of course. Dogs on leads are welcome inside and out.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-2",
                      "question": "Is there step-free access?",
                      "answer": "<p>Yes, through the front door, and there's an accessible toilet.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-3",
                      "question": "Do you do vegan food?",
                      "answer": "<p>Yes. Ask for the vegan breakfast, or the soup, which is usually vegan too.</p>"
                    }
                  }
                ]
              }
            },
            {
              "type": "ContactForm",
              "props": {
                "id": "contact-form",
                "colors": "inverse",
                "title": "Send us a message",
                "text": "<p>Questions about catering, parties or anything else. We reply within a day.</p>",
                "askPhone": false,
                "buttonLabel": "Send"
              }
            }
          ]
        }
      },

    "pages": {
      "cafe-home": {
        "id": "cafe-home",
        "kind": "page",
        "slug": "home",
        "title": "Home",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Hero",
              "props": {
                "id": "hero",
                "variant": "split",
                "colors": "page",
                "alignment": "left",
                "title": "Good coffee and proper breakfasts",
                "text": "A small café by the river in Kendal, open seven days a week.",
                "buttonLabel": "See the menu",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "cafe-menu",
                  "newTab": false
                },
                "image": {
                  "mediaId": "cafe-hero"
                }
              }
            },
            {
              "type": "Features",
              "props": {
                "id": "features",
                "variant": "centred",
                "colors": "page",
                "title": "Why people come back",
                "text": "<p>Simple food, <span class=\"bg-secondary/30\">cooked well</span>, and a seat by the window if you're quick.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-0",
                      "icon": "coffee",
                      "title": "Coffee roasted down the road",
                      "text": "<p>Our beans come from a roaster two miles away, and change with the seasons.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-1",
                      "icon": "croissant",
                      "title": "Baked every morning",
                      "text": "<p>Bread, scones and cakes from our own oven, ready when we open.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-2",
                      "icon": "dog",
                      "title": "Dogs and muddy boots welcome",
                      "text": "<p>Water bowls by the door, and biscuits behind the counter.</p>"
                    }
                  }
                ],
                "hover": "lift"
              }
            },
            {
              "type": "Gallery",
              "props": {
                "id": "gallery",
                "variant": "featured",
                "colors": "page",
                "title": "From the counter",
                "images": [
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-0",
                      "image": {
                        "mediaId": "cafe-breakfast"
                      },
                      "caption": "Eggs and seeded toast"
                    }
                  },
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-1",
                      "image": {
                        "mediaId": "cafe-cake"
                      },
                      "caption": "Lemon cake, every day"
                    }
                  },
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-2",
                      "image": {
                        "mediaId": "cafe-coffee"
                      },
                      "caption": "A flat white"
                    }
                  },
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-3",
                      "image": {
                        "mediaId": "cafe-lunch"
                      },
                      "caption": "Soup of the day"
                    }
                  }
                ]
              }
            },
            {
              "type": "Testimonials",
              "props": {
                "id": "testimonials",
                "variant": "cards",
                "colors": "inverse",
                "title": "What our regulars say",
                "items": [
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-0",
                      "quote": "The best breakfast in town, and they always remember how I take my coffee.",
                      "name": "Margaret",
                      "role": "Comes in every Saturday"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-1",
                      "quote": "We stop here after every walk. The dog gets a biscuit and we get the cake.",
                      "name": "Owen",
                      "role": "Walks the river path"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-2",
                      "quote": "Friendly, quick and never rushed. Lovely spot to work for an hour.",
                      "name": "Aisha",
                      "role": "Works from the window seat"
                    }
                  }
                ]
              }
            },
            {
              "type": "CallToAction",
              "props": {
                "id": "call-to-action",
                "variant": "banner",
                "colors": "page",
                "title": "Coming with six or more?",
                "text": "Call us the day before and we'll keep a table for you.",
                "buttonLabel": "Call us",
                "buttonLink": {
                  "kind": "phone",
                  "number": "+44 1632 960 123"
                },
                "backgroundImage": {
                  "mediaId": "cafe-riverside"
                },
                "overlay": "80",
                "overlayColor": "neutral"
              }
            }
          ]
        }

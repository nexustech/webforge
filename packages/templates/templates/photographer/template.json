          "content": [
            {
              "type": "TextImage",
              "props": {
                "variant": "imageRight",
                "colors": "page",
                "title": "About me",
                "text": "<p>I'm Rowan Hale. I've walked the north coast with a camera for fifteen years, waiting for the light to do something worth keeping.</p><p>Alongside my landscapes I photograph people: families, couples and the people who work by the sea. I like pictures that feel like the day felt.</p>",
                "image": {
                  "mediaId": "MmunpxZS0esQCty3"
                },
                "id": "textimage-16"
              }
            },
            {
              "type": "Stats",
              "props": {
                "variant": "row",
                "colors": "inverse",
                "title": "Along the way",
                "text": "<p>A few things I'm proud of.</p>",

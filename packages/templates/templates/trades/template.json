      "trades-home": {
        "id": "trades-home",
        "kind": "page",
        "slug": "home",
        "title": "Home",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Hero",
              "props": {
                "id": "hero",
                "variant": "split",
                "colors": "page",
                "alignment": "left",
                "title": "Safe, tidy electrical work in Leeds",
                "text": "Rewires, lighting, fuse boxes and car chargers, from a small local team that turns up when we say we will.",
                "buttonLabel": "Get a free quote",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "trades-contact",
                  "newTab": false
                },
                "image": {
                  "mediaId": "trades-hero"
                }
              }
            },
            {
              "type": "Stats",
              "props": {
                "id": "stats",
                "variant": "row",
                "colors": "inverse",
                "title": "Since 2010",
                "text": "<p>Homes and small businesses across Leeds and nearby.</p>",
                "items": [
                  {
                    "type": "Stat",
                    "props": {
                      "id": "stat-0",
                      "number": "1,200+",
                      "label": "jobs done"
                    }
                  },
                  {
                    "type": "Stat",
                    "props": {
                      "id": "stat-1",
                      "number": "15",
                      "label": "years in business"
                    }
                  },
                  {
                    "type": "Stat",
                    "props": {
                      "id": "stat-2",
                      "number": "4.9",
                      "label": "average review"
                    }
                  }
                ],
                "lookCase": "uppercase"
              }
            },
            {
              "type": "Features",
              "props": {
                "id": "features",
                "variant": "centred",
                "colors": "page",
                "title": "Why choose us",
                "text": "<p>The things people tell us they value most.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-0",
                      "icon": "shield-check",
                      "title": "Registered and insured",
                      "text": "<p>Every job is certified, and we give you the paperwork when we finish.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-1",
                      "icon": "clock",
                      "title": "On time, or we call ahead",
                      "text": "<p>You get a time slot, and a call if anything changes.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-2",
                      "icon": "sparkles",
                      "title": "We clean up after ourselves",
                      "text": "<p>Dust sheets down, and everything swept up before we go.</p>"
                    }
                  }
                ]
              }
            },
            {
              "type": "Testimonials",
              "props": {
                "id": "testimonials",
                "variant": "cards",
                "colors": "page",
                "title": "What customers say",
                "items": [
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-0",
                      "quote": "Rewired our whole house in four days and left it spotless. Clear prices from the start.",
                      "name": "Gareth",
                      "role": "Full rewire, Headingley"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-1",
                      "quote": "Fitted our car charger the week after we asked. Neat job, and they showed us how the app works.",
                      "name": "Nadia",
                      "role": "EV charger, Roundhay"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-2",
                      "quote": "Came out the same day when our power kept tripping, and found the fault in an hour.",
                      "name": "Chris",
                      "role": "Fault finding, Morley"
                    }
                  }
                ]
              }
            },
            {
              "type": "CallToAction",
              "props": {
                "id": "call-to-action",
                "variant": "banner",
                "colors": "inverse",
                "title": "Need an electrician this week?",
                "text": "Ring us and we'll tell you when we can come, and roughly what it will cost.",
                "buttonLabel": "Call us",
                "buttonLink": {
                  "kind": "phone",
                  "number": "+44 1632 960 789"
                },
                "backgroundImage": {
                  "mediaId": "trades-van"
                },
                "overlay": "60",
                "overlayColor": "neutral"
              }
            }
          ]
        }
      },
      "trades-services": {
        "id": "trades-services",
        "kind": "page",
        "slug": "services",
        "title": "Services",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Features",
              "props": {
                "id": "services",
                "variant": "cards",
                "colors": "page",
                "title": "What we do",
                "text": "<p>For homes, landlords and small businesses.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "service-0",
                      "icon": "house",
                      "title": "Rewires",
                      "text": "<p>Whole or part rewires, planned around you so you're never without power for long.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "service-1",
                      "icon": "lightbulb",
                      "title": "Lighting",
                      "text": "<p>New lights inside and out, spotlights, dimmers and garden lighting.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "service-2",
                      "icon": "zap",
                      "title": "Fuse boxes",
                      "text": "<p>New consumer units with the latest safety switches.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "service-3",
                      "icon": "plug-zap",
                      "title": "Car chargers",
                      "text": "<p>Home chargers fitted, with help to get the grant if you can.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "service-4",
                      "icon": "wrench",
                      "title": "Fault finding",
                      "text": "<p>Tripping power, dead sockets and flickering lights, found and fixed.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "service-5",
                      "icon": "clipboard-check",
                      "title": "Safety checks",
                      "text": "<p>Electrical reports for homeowners, landlords and buyers.</p>"
                    }
                  }
                ],
                "hover": "lift"
              }
            },
            {
              "type": "Pricing",
              "props": {
                "id": "prices",
                "variant": "cards",
                "colors": "inverse",
                "title": "Prices for common jobs",
                "text": "<p>Fixed prices, agreed before we start. Bigger jobs get a free written quote.</p>",
                "items": [
                  {
                    "type": "PricingPlan",
                    "props": {
                      "id": "price-0",
                      "name": "Safety check",
                      "price": "£160",
                      "period": "up to 10 circuits",
                      "details": "<p>A full electrical report with any faults explained in plain English.</p>",
                      "buttonLabel": "Book a check",
                      "link": {
                        "kind": "page",
                        "pageId": "trades-contact",
                        "newTab": false
                      },
                      "featured": false,
                      "badge": ""
                    }
                  },
                  {
                    "type": "PricingPlan",
                    "props": {
                      "id": "price-1",
                      "name": "New fuse box",
                      "price": "£550",
                      "period": "fitted",
                      "details": "<p>A new consumer unit, tested and certified, usually in a day.</p>",
                      "buttonLabel": "Get a quote",
                      "link": {
                        "kind": "page",
                        "pageId": "trades-contact",
                        "newTab": false
                      },
                      "featured": true,
                      "badge": "Most asked for"
                    }
                  },
                  {
                    "type": "PricingPlan",
                    "props": {
                      "id": "price-2",
                      "name": "Car charger",
                      "price": "from £850",
                      "period": "fitted",
                      "details": "<p>A 7 kW home charger on your wall, set up and tested.</p>",
                      "buttonLabel": "Get a quote",
                      "link": {
                        "kind": "page",
                        "pageId": "trades-contact",
                        "newTab": false
                      },
                      "featured": false,
                      "badge": ""
                    }
                  }
                ]
              }
            },
            {
              "type": "Faq",
              "props": {
                "id": "faq",
                "variant": "accordion",
                "colors": "page",
                "title": "Questions we're often asked",
                "items": [
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-0",
                      "question": "Do you give free quotes?",
                      "answer": "<p>Yes. For anything bigger than a small job we'll come and look, then send a written quote.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-1",
                      "question": "Which areas do you cover?",
                      "answer": "<p>Leeds and anywhere within about 15 miles: Wakefield, Bradford and Harrogate included.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-2",
                      "question": "Will I get a certificate?",
                      "answer": "<p>Yes. Every job that needs one is certified, and we send it to you and to building control.</p>"
                    }
                  }
                ]
              }
            }
          ]
        }

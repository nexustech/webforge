    "pages": {
      "salon-home": {
        "id": "salon-home",
        "kind": "page",
        "slug": "home",
        "title": "Home",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Hero",
              "props": {
                "id": "hero",
                "variant": "split",
                "colors": "page",
                "alignment": "left",
                "title": "Hair and beauty, with time to talk",
                "text": "A friendly salon on Harrogate high street, for cuts, colour, nails, brows and lashes.",
                "buttonLabel": "See treatments",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "salon-treatments",
                  "newTab": false
                },
                "image": {
                  "mediaId": "salon-hero"
                }
              }
            },
            {
              "type": "Features",
              "props": {
                "id": "features",
                "variant": "centred",
                "colors": "page",
                "title": "What we do",
                "text": "<p>Everything takes as long as it needs, never longer.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-0",
                      "icon": "scissors",
                      "title": "Cuts and colour",
                      "text": "<p>For every length and type of hair, with a proper chat first about what you want.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-1",
                      "icon": "sparkles",
                      "title": "Nails, brows and lashes",
                      "text": "<p>Gel and natural nails, brow shaping and tinting, and lash lifts.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-2",
                      "icon": "calendar-check",
                      "title": "Easy to book",
                      "text": "<p>Ring us, send a message, or ask at the desk. Late appointments on Thursdays.</p>"
                    }
                  }
                ]
              }
            },
            {
              "type": "Gallery",
              "props": {
                "id": "gallery",
                "variant": "grid",
                "colors": "page",
                "title": "Recent work",
                "images": [
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-0",
                      "image": {
                        "mediaId": "salon-work-1"
                      },
                      "caption": "Soft blonde ends"
                    }
                  },
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-1",
                      "image": {
                        "mediaId": "salon-work-2"
                      },
                      "caption": "A short, sharp cut"
                    }
                  },
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-2",
                      "image": {
                        "mediaId": "salon-work-3"
                      },
                      "caption": "Manicures"
                    }
                  },
                  {
                    "type": "GalleryImage",
                    "props": {
                      "id": "image-3",
                      "image": {
                        "mediaId": "salon-work-4"
                      },
                      "caption": "Lashes and eye make-up"
                    }
                  }
                ]
              }
            },
            {
              "type": "Testimonials",
              "props": {
                "id": "testimonials",
                "variant": "cards",
                "colors": "inverse",
                "title": "Kind words",
                "items": [
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-0",
                      "quote": "Ella listened to exactly what I wanted, and it's the best my hair has looked in years.",
                      "name": "Rachel",
                      "role": "Cut and colour"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-1",
                      "quote": "Relaxed, welcoming and never rushed. My nails lasted three weeks.",
                      "name": "Holly",
                      "role": "Gel nails"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-2",
                      "quote": "The Thursday evening slots are a lifesaver when you work full time.",
                      "name": "Sophie",
                      "role": "Brows and lashes"
                    }
                  }
                ]
              }
            },
            {
              "type": "CallToAction",
              "props": {
                "id": "call-to-action",
                "variant": "banner",
                "colors": "page",
                "title": "New to Willow?",
                "text": "Tell us what you'd like and we'll find a time that suits you.",
                "buttonLabel": "Book an appointment",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "salon-book",
                  "newTab": false
                }
              }
            }
          ]

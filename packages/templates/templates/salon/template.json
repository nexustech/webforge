      "salon-treatments": {
        "id": "salon-treatments",
        "kind": "page",
        "slug": "treatments",
        "title": "Treatments",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "TextSection",
              "props": {
                "id": "hair",
                "colors": "page",
                "title": "Hair",
                "text": "<p><strong>Cut and finish</strong> · from £38<br>Includes a consultation, wash and blow-dry.</p><p><strong>Restyle</strong> · from £48<br>For a big change, with extra time to plan it.</p><p><strong>Blow-dry</strong> · from £25<br>Smooth, curled or textured.</p><p><strong>Children's cut</strong> · from £18<br>Up to the age of 12.</p>"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "id": "colour",
                "colors": "inverse",
                "title": "Colour",
                "text": "<p><strong>Root tint</strong> · from £55<br>Covers up to an inch of regrowth.</p><p><strong>Half head of highlights</strong> · from £70<br>Foils through the top and sides.</p><p><strong>Balayage</strong> · from £95<br>Hand-painted, soft colour that grows out gently.</p><p><strong>Gloss</strong> · from £30<br>Adds shine and tones brassiness between colours.</p>"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "id": "beauty",
                "colors": "page",
                "title": "Nails, brows and lashes",
                "text": "<p><strong>Gel manicure</strong> · £30<br>Shaping, cuticle care and gel colour that lasts two to three weeks.</p><p><strong>Brow shape and tint</strong> · £20<br>Waxed and tinted to suit your face.</p><p><strong>Lash lift and tint</strong> · £45<br>Curls and darkens your own lashes for six to eight weeks.</p>"
              }
            },
            {
              "type": "Faq",
              "props": {
                "id": "faq",
                "variant": "accordion",
                "colors": "page",
                "title": "Before you come in",
                "items": [
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-0",
                      "question": "Do I need a patch test?",
                      "answer": "<p>Yes, for any colour, tint or lash lift: pop in for a quick test at least 48 hours before your appointment.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-1",
                      "question": "How much notice do you need to cancel?",
                      "answer": "<p>Please give us 24 hours, so someone else can have the appointment.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-2",
                      "question": "Do you do bridal hair?",
                      "answer": "<p>We do. Get in touch with the date and we'll plan a trial with you.</p>"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "salon-about": {
        "id": "salon-about",
        "kind": "page",
        "slug": "about",
        "title": "About us",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "TextImage",
              "props": {
                "id": "story",
                "variant": "imageLeft",
                "colors": "page",
                "title": "Our salon",
                "text": "<p>Ella opened Willow in 2018 after twelve years of working in city salons. She wanted somewhere calmer, where every appointment comes with a cup of tea and nobody is rushed.</p><p>We use cruelty-free products, recycle our foils and colour tubes, and keep learning: every one of us trains for at least a week a year.</p>",
                "image": {
                  "mediaId": "salon-salon"
                }
              }
            },
            {
              "type": "Team",
              "props": {
                "id": "team",
                "variant": "cards",
                "colors": "page",
                "title": "Meet the team",
                "text": "<p>Three of us, and a very good kettle.</p>",
                "items": [
                  {
                    "type": "TeamMember",
                    "props": {
                      "id": "member-0",
                      "name": "Ella",
                      "role": "Owner and senior stylist",
                      "text": "<p>Cuts, restyles and bridal hair.</p>",
                      "photo": {
                        "mediaId": "salon-ella"
                      }
                    }
                  },
                  {
                    "type": "TeamMember",
                    "props": {
                      "id": "member-1",
                      "name": "Maya",
                      "role": "Colourist",
                      "text": "<p>Balayage, highlights and colour corrections.</p>",
                      "photo": {
                        "mediaId": "salon-maya"
                      }
                    }
                  },
                  {
                    "type": "TeamMember",
                    "props": {
                      "id": "member-2",
                      "name": "Jess",
                      "role": "Beauty therapist",
                      "text": "<p>Nails, brows and lashes.</p>",
                      "photo": {
                        "mediaId": "salon-jess"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }

      "jCUMUx5lXz9bV2pE": {
        "id": "jCUMUx5lXz9bV2pE",
        "kind": "page",
        "slug": "home",
        "title": "Home",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Hero",
              "props": {
                "variant": "split",
                "colors": "page",
                "alignment": "left",
                "title": "Clear advice for growing businesses",
                "text": "I help owners of small businesses plan, price and grow, with straight answers and no jargon.",
                "buttonLabel": "Book a free call",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "5pvnZYpDDLeQ1PJz",
                  "newTab": false
                },
                "image": {
                  "mediaId": "M2aG1VvmAmNFa5X2"
                },
                "id": "hero-1"
              }
            },
            {
              "type": "Features",
              "props": {
                "variant": "cards",
                "colors": "page",
                "title": "How I can help",
                "text": "<p>Practical help with the parts of running a business that <span class=\"text-primary\">keep you up at night</span>.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-0",
                      "icon": "compass",
                      "title": "Planning",
                      "text": "<p>A one-page plan for the year ahead, with goals you can measure and steps you can take on Monday.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-1",
                      "icon": "piggy-bank",
                      "title": "Pricing",
                      "text": "<p>Prices that cover your costs, reward your time and still win the work you want.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-2",
                      "icon": "users",
                      "title": "People",
                      "text": "<p>Hiring your first employee, writing roles and keeping a small team pulling the same way.</p>"
                    }
                  }
                ],
                "id": "features-2",
                "hover": "shadow"
              }
            },
            {
              "type": "Testimonials",
              "props": {
                "variant": "cards",
                "colors": "page",
                "title": "What clients say",
                "items": [
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-0",
                      "quote": "Jo helped us raise our prices with confidence. We lost no customers and gained a day a week.",
                      "name": "Sam Patel",
                      "role": "Owner, Patel Joinery"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-1",
                      "quote": "The planning day was the best money we spent all year. We still use the one-page plan.",
                      "name": "Rachel Moore",
                      "role": "Director, Little Steps Nursery"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-2",
                      "quote": "Straight answers, no jargon, and always on the end of the phone when it mattered.",
                      "name": "Owen Price",
                      "role": "Founder, Price & Daughters"
                    }
                  }
                ],
                "id": "testimonials-3"
              }
            },
            {
              "type": "CallToAction",
              "props": {
                "variant": "banner",
                "colors": "inverse",
                "title": "Not sure where to start?",
                "text": "Book a free 30-minute call. We'll talk about your business and I'll tell you honestly whether I can help.",
                "buttonLabel": "Book a free call",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "5pvnZYpDDLeQ1PJz",
                  "newTab": false
                },
                "id": "calltoaction-4"
              }
            }
          ]

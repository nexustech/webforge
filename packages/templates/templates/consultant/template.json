      "HPBEA4fY5A4bVDE0": {
        "id": "HPBEA4fY5A4bVDE0",
        "kind": "page",
        "slug": "services",
        "title": "Services",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Pricing",
              "props": {
                "variant": "cards",
                "colors": "page",
                "title": "Ways to work together",
                "text": "<p>Fixed prices, agreed before we start. No hourly surprises.</p>",
                "items": [
                  {
                    "type": "PricingPlan",
                    "props": {
                      "id": "plan-0",
                      "name": "Health check",
                      "price": "£450",
                      "period": "one-off",
                      "details": "<p>A half-day review of your numbers, prices and plans, with a written report and three things to do first.</p>",
                      "buttonLabel": "Get in touch",
                      "link": {
                        "kind": "page",
                        "pageId": "5pvnZYpDDLeQ1PJz",
                        "newTab": false
                      },
                      "featured": false,
                      "badge": ""
                    }
                  },
                  {
                    "type": "PricingPlan",
                    "props": {
                      "id": "plan-1",
                      "name": "Monthly adviser",
                      "price": "£600",
                      "period": "a month",
                      "details": "<p>A monthly meeting, help between meetings by phone and email, and a quarterly review of your plan.</p>",
                      "buttonLabel": "Get in touch",
                      "link": {
                        "kind": "page",
                        "pageId": "5pvnZYpDDLeQ1PJz",
                        "newTab": false
                      },
                      "featured": true,
                      "badge": "Most chosen"
                    }
                  },
                  {
                    "type": "PricingPlan",
                    "props": {
                      "id": "plan-2",
                      "name": "Strategy day",
                      "price": "£1,200",
                      "period": "a day",
                      "details": "<p>A full day with you and your team to agree where the business is going and how it gets there.</p>",
                      "buttonLabel": "Get in touch",
                      "link": {
                        "kind": "page",
                        "pageId": "5pvnZYpDDLeQ1PJz",
                        "newTab": false
                      },
                      "featured": false,
                      "badge": ""
                    }
                  }
                ],
                "id": "pricing-5"
              }
            },
            {
              "type": "Faq",
              "props": {
                "variant": "accordion",
                "colors": "page",
                "title": "Questions",
                "items": [
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-0",
                      "question": "Who do you work with?",
                      "answer": "<p>Owners of businesses with up to 50 people: shops, trades, nurseries, studios and services.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-1",
                      "question": "Do you work remotely?",
                      "answer": "<p>Yes. Most meetings are by video, and I visit in person when it helps.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-2",
                      "question": "Is the first call really free?",
                      "answer": "<p>Yes. Thirty minutes, no obligation and no sales pitch.</p>"
                    }
                  },
                  {
                    "type": "FaqItem",
                    "props": {
                      "id": "faq-3",
                      "question": "How do I pay?",
                      "answer": "<p>By bank transfer, monthly for the adviser service and on completion for the rest.</p>"
                    }
                  }
                ],
                "id": "faq-6"
              }
            }
          ]
        }

      "f6YidfNWtilI2x4W": {
        "id": "f6YidfNWtilI2x4W",
        "kind": "page",
        "slug": "about",
        "title": "About me",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "TextImage",
              "props": {
                "variant": "imageLeft",
                "colors": "page",
                "title": "About me",
                "text": "<p>I'm a designer and illustrator working from a small studio by the river. I grew up drawing on everything, and I still start every project with a pencil.</p><p>I work best with people who care about what they make: bakers, makers, shop owners and small teams. I keep things simple, explain my choices, and stay in touch from the first call to the last file.</p>",
                "image": {
                  "mediaId": "UhhqOwXG7qQQnUdF"
                },
                "id": "textimage-15"
              }
            },
            {
              "type": "Features",
              "props": {
                "variant": "list",
                "colors": "page",
                "title": "Experience",
                "text": "<p>Where I've worked, and what I did there.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "experience-0",
                      "icon": "briefcase",
                      "title": "Freelance designer · 2019 to now",
                      "text": "<p>Branding, websites and illustration for more than 40 small businesses and charities.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "experience-1",
                      "icon": "building",
                      "title": "Senior designer, Northgate Studio · 2015 to 2019",
                      "text": "<p>Led the design of shop interiors, signs and packaging for local and national brands.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "experience-2",
                      "icon": "graduation-cap",
                      "title": "BA in Graphic Design · 2011 to 2014",
                      "text": "<p>Studied type, print and illustration, with a final project on hand-painted shop signs.</p>"
                    }
                  }
                ],
                "id": "features-16"
              }
            },
            {
              "type": "TextSection",
              "props": {
                "colors": "inverse",
                "title": "Skills and tools",
                "text": "<p>Logo and brand design · Web design · Illustration, by hand and on screen · Print and packaging · Sign painting</p><p>Figma · Adobe Illustrator and Photoshop · Procreate · Webforge</p>",
                "id": "textsection-17"
              }
            }
          ]
        }
      },

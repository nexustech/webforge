      "F0FsPQtiejn9HlKU": {
        "id": "F0FsPQtiejn9HlKU",
        "kind": "page",
        "slug": "home",
        "title": "Home",
        "settings": {
          "hideHeader": false,
          "hideFooter": false,
          "hideFromNavigation": false
        },
        "doc": {
          "root": {
            "props": {}
          },
          "content": [
            {
              "type": "Hero",
              "props": {
                "variant": "split",
                "colors": "page",
                "title": "Hello, I'm Alex Morgan",
                "text": "A freelance designer and illustrator. I help small businesses look their best, in print and online.",
                "buttonLabel": "See my work",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "GK87jx1B0n7wMn7F",
                  "newTab": false
                },
                "alignment": "centre",
                "image": {
                  "mediaId": "17sEwJXo82O6Coqq"
                },
                "id": "hero-10"
              }
            },
            {
              "type": "Stats",
              "props": {
                "variant": "row",
                "colors": "inverse",
                "title": "In numbers",
                "text": "<p>Twelve years of work for shops, cafés, studios and charities.</p>",
                "items": [
                  {
                    "type": "Stat",
                    "props": {
                      "id": "stat-0",
                      "number": "12",
                      "label": "years designing"
                    }
                  },
                  {
                    "type": "Stat",
                    "props": {
                      "id": "stat-1",
                      "number": "150+",
                      "label": "projects finished"
                    }
                  },
                  {
                    "type": "Stat",
                    "props": {
                      "id": "stat-2",
                      "number": "40",
                      "label": "regular clients"
                    }
                  }
                ],
                "id": "stats-11",
                "lookCase": "uppercase"
              }
            },
            {
              "type": "Features",
              "props": {
                "variant": "cards",
                "colors": "page",
                "title": "What I can do for you",
                "text": "<p>From a first sketch to the finished thing, done properly and <span class=\"bg-secondary/30\">on time</span>.</p>",
                "items": [
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-0",
                      "icon": "sparkles",
                      "title": "Branding",
                      "text": "<p>A logo, colours and type that say who you are, and a short guide to using them.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-1",
                      "icon": "monitor-smartphone",
                      "title": "Websites",
                      "text": "<p>Simple, fast websites that look good on every screen and are easy to keep up to date.</p>"
                    }
                  },
                  {
                    "type": "Feature",
                    "props": {
                      "id": "feature-2",
                      "icon": "palette",
                      "title": "Illustration",
                      "text": "<p>Drawings for books, packaging, menus and walls, in a warm, hand-made style.</p>"
                    }
                  }
                ],
                "id": "features-12",
                "hover": "lift"
              }
            },
            {
              "type": "Testimonials",
              "props": {
                "variant": "cards",
                "colors": "page",
                "title": "What clients say",
                "items": [
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-0",
                      "quote": "Alex understood what we wanted straight away. Our new sign has customers stopping to take photos.",
                      "name": "Priya Shah",
                      "role": "Owner, Rise Bakery"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-1",
                      "quote": "Clear, quick and lovely to work with. The website was ready a week early.",
                      "name": "Tom Becker",
                      "role": "Architect"
                    }
                  },
                  {
                    "type": "Testimonial",
                    "props": {
                      "id": "testimonial-2",
                      "quote": "The illustrations brought our book to life. We've already asked Alex to do the next one.",
                      "name": "Hannah Lowe",
                      "role": "Editor, Little Acorn Books"
                    }
                  }
                ],
                "id": "testimonials-13"
              }
            },
            {
              "type": "CallToAction",
              "props": {
                "variant": "banner",
                "colors": "inverse",
                "title": "Have a project in mind?",
                "text": "I'm taking on new work from next month. Tell me about yours.",
                "buttonLabel": "Get in touch",
                "buttonLink": {
                  "kind": "page",
                  "pageId": "nSol0HopYKvtpYSy",

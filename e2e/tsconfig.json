{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // page.evaluate() callbacks run in the renderer, so tests also need DOM types.
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "app",
    "export",
    "packaged",
    "perf",
    "visual",
    "playwright.config.ts",
    "playwright.packaged.config.ts",
    "playwright.perf.config.ts",
    "playwright.visual.config.ts"
  ],
  "references": [
    { "path": "../packages/model" },
    { "path": "../packages/pipeline" },
    { "path": "../packages/site-components" },
    { "path": "../packages/storage" },
    { "path": "../packages/templates" },
    { "path": "../packages/test-utils" },
    { "path": "../packages/themes" }
  ]
}

{
  "name": "webforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@webforge/desktop",
    "build": "turbo run build",
    "test": "vitest run --coverage",
    "e2e": "turbo run build --filter=@webforge/desktop && pnpm --filter @webforge/e2e e2e",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "deps": "depcruise apps packages e2e tools",
    "knip": "knip",
    "licence-check": "pnpm licenses list -r --json | node tools/src/check-licences.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm deps && pnpm knip && pnpm licence-check && pnpm test"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@swc/core": "1.16.18",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}
